new file mode 100644
index 0000000..a926dd8
--- /dev/null
+++ b/game-server/src/protocol.js
@@ -0,0 +1,100 @@
+'use strict';
+const crypto = require('crypto');
+
+// ---------------------------------------------------------------------------
+// UDP protocol v2
+//
+// Klien -> Server (44 byte, little-endian):
+//   0      u8   type = 0x02
+//   1      u8   mapId (0xFF = tidak valid / menu)
+//   2..4   u16  partner species
+//   4..8   i32  tamer X
+//   8..12  i32  tamer Y
+//   12..16 i32  tamer Z
+//   16..18 i16  tamer yaw
+//   18     u8   tamer anim
+//   19     u8   partner anim
+//   20..24 i32  partner X
+//   24..28 i32  partner Z
+//   28..32 u32  sessionId  (dari LOGIN_SUCCESS)
+//   32..36 u32  seq        (naik terus; aritmetika serial mod 2^32)
+//   36..44 8B   MAC = HMAC-SHA256(sessionKey, bytes[0..36])[0..8]
+//
+// Server -> Klien (32 byte), disiarkan ke pemain lain di map yang sama:
+//   layout byte 0..28 identik dengan di atas, kecuali:
+//   0      u8   type = 0x03
+//   28..32 u32  tamerId pengirim (ditentukan SERVER, bukan klien)
+// ---------------------------------------------------------------------------
+
+const UDP_IN_TYPE = 0x02;
+const UDP_IN_LEN = 44;
+const UDP_OUT_TYPE = 0x03;
+const UDP_OUT_LEN = 32;
+const MAC_LEN = 8;
+const MAP_NONE = 0xff;
+
+function computeMac(key, buf) {
+  return crypto.createHmac('sha256', key).update(buf.subarray(0, 36)).digest().subarray(0, MAC_LEN);
+}
+
+function verifyMac(key, buf) {
+  const expected = computeMac(key, buf);
+  return crypto.timingSafeEqual(expected, buf.subarray(36, 36 + MAC_LEN));
+}
+
+// Aritmetika serial (RFC 1982): seq dianggap lebih baru bila selisihnya 1..2^31-1.
+function isNewer(seq, last) {
+  if (last === null) return true;
+  const d = (seq - last) >>> 0;
+  return d !== 0 && d < 0x80000000;
+}
+
+function parseSync(buf) {
+  return {
+    mapId: buf.readUInt8(1),
+    species: buf.readUInt16LE(2),
+    x: buf.readInt32LE(4),
+    y: buf.readInt32LE(8),
+    z: buf.readInt32LE(12),
+    yaw: buf.readInt16LE(16),
+    anim: buf.readUInt8(18),
+    dAnim: buf.readUInt8(19),
+    dx: buf.readInt32LE(20),
+    dz: buf.readInt32LE(24),
+    sessionId: buf.readUInt32LE(28),
+    seq: buf.readUInt32LE(32),
+  };
+}
+
+function buildRelay(inbound, tamerId) {
+  const out = Buffer.alloc(UDP_OUT_LEN);
+  out[0] = UDP_OUT_TYPE;
+  inbound.copy(out, 1, 1, 28);
+  out.writeUInt32LE(tamerId >>> 0, 28);
+  return out;
+}
+
+// Dipakai test (dan sebagai referensi implementasi klien).
+function buildClientPacket(sessionId, key, seq, f) {
+  const b = Buffer.alloc(UDP_IN_LEN);
+  b[0] = UDP_IN_TYPE;
+  b.writeUInt8(f.mapId & 0xff, 1);
+  b.writeUInt16LE(f.species || 0, 2);
+  b.writeInt32LE(f.x || 0, 4);
+  b.writeInt32LE(f.y || 0, 8);
+  b.writeInt32LE(f.z || 0, 12);
+  b.writeInt16LE(f.yaw || 0, 16);
+  b.writeUInt8(f.anim || 0, 18);
+  b.writeUInt8(f.dAnim || 0, 19);
+  b.writeInt32LE(f.dx || 0, 20);
+  b.writeInt32LE(f.dz || 0, 24);
+  b.writeUInt32LE(sessionId >>> 0, 28);
+  b.writeUInt32LE(seq >>> 0, 32);
+  computeMac(key, b).copy(b, 36);
+  return b;
+}
+
+module.exports = {
+  UDP_IN_TYPE, UDP_IN_LEN, UDP_OUT_TYPE, UDP_OUT_LEN, MAC_LEN, MAP_NONE,
+  computeMac, verifyMac, isNewer, parseSync, buildRelay, buildClientPacket,
+};
diff --git a/game-server/src/server.js b/game-server/src/server.js
new file mode 100644
index 0000000..3a4191f
--- /dev/null
+++ b/game-server/src/server.js
@@ -0,0 +1,49 @@
+'use strict';
+const { loadConfig } = require('./config');
+const { openDb, createStore } = require('./db');
+const { SessionManager } = require('./sessions');
+const { createUdp } = require('./udp');
+const { createWs } = require('./ws');
+
+function makeLogger(quiet) {
+  const ts = () => new Date().toISOString();
+  return {
+    info: (...a) => { if (!quiet) console.log(ts(), '[INFO]', ...a); },
+    error: (...a) => console.error(ts(), '[ERROR]', ...a),
+  };
+}
+
+async function startServer(overrides = {}) {
+  const cfg = loadConfig(overrides);
+  const log = makeLogger(cfg.quiet);
+  const db = openDb(cfg.dbPath, cfg.schemaPath);
+  const store = createStore(db);
+  const sessions = new SessionManager(store, cfg, log);
+  const udp = createUdp(sessions, cfg, log);
+  const udpPortRef = { port: cfg.udpPort };
+  const ws = createWs(sessions, store, cfg, log, udpPortRef);
+
+  udpPortRef.port = await udp.bind();
+  const wsPort = await ws.listening();
+
+  const timers = [
+    setInterval(() => sessions.sweepStale(), 2000),
+    setInterval(() => sessions.persistDirty(), cfg.persistIntervalMs),
+  ];
+  timers.forEach((t) => t.unref());
+  log.info(`DB: ${cfg.dbPath}`);
+  log.info(`WebSocket (auth) di ${cfg.host}:${wsPort} | UDP (fast-sync) di ${cfg.host}:${udpPortRef.port}`);
+
+  return {
+    cfg, db, sessions, udp, wsPort, udpPort: udpPortRef.port,
+    async stop() {
+      timers.forEach(clearInterval);
+      sessions.removeAll('server berhenti');
+      await ws.close();
+      await udp.close();
+      db.close();
+    },
+  };
+}
+
+module.exports = { startServer };
diff --git a/game-server/src/sessions.js b/game-server/src/sessions.js
new file mode 100644
index 0000000..19a5f75
--- /dev/null
+++ b/game-server/src/sessions.js
@@ -0,0 +1,127 @@
+'use strict';
+const crypto = require('crypto');
+const { TokenBucket } = require('./limiter');
+
+function send(ws, obj) {
+  if (ws && ws.readyState === 1) ws.send(JSON.stringify(obj));
+}
+
+// Satu Session = satu pemain yang sudah login lewat WebSocket.
+// Hanya SessionManager yang boleh mengubah daftar sesi dan keanggotaan map.
+class SessionManager {
+  constructor(store, cfg, log) {
+    this.store = store;
+    this.cfg = cfg;
+    this.log = log;
+    this.byId = new Map();      // sessionId -> session
+    this.byTamer = new Map();   // tamerId   -> session
+    this.maps = new Map();      // mapId     -> Set<session>  (instance/phasing)
+  }
+
+  get size() { return this.byId.size; }
+  get(sessionId) { return this.byId.get(sessionId); }
+
+  create({ accountId, tamer, ws }) {
+    if (this.byTamer.has(tamer.TamerID)) this.remove(this.byTamer.get(tamer.TamerID), 'login dari tempat lain');
+    let sessionId;
+    do { sessionId = crypto.randomInt(1, 0xffffffff); } while (this.byId.has(sessionId));
+    const s = {
+      sessionId,
+      key: crypto.randomBytes(32),
+      accountId,
+      tamerId: tamer.TamerID,
+      tamerName: tamer.TamerName,
+      ws,
+      addr: null, port: null,
+      lastSeq: null,
+      mapId: null,
+      species: 0,
+      pos: null,          // {x,y,z} terakhir yang tervalidasi
+      dirty: false,
+      lastUdp: 0,
+      bucket: new TokenBucket(40, 60),
+    };
+    this.byId.set(sessionId, s);
+    this.byTamer.set(s.tamerId, s);
+    return s;
+  }
+
+  // Dipanggil UDP handler untuk paket yang sudah lolos MAC + seq + rate limit.
+  applySync(s, sync, rinfo) {
+    s.addr = rinfo.address;
+    s.port = rinfo.port;
+    s.lastSeq = sync.seq;
+    s.lastUdp = Date.now();
+    s.species = sync.species;
+    s.pos = { x: sync.x, y: sync.y, z: sync.z };
+    s.dirty = true;
+    if (s.mapId !== sync.mapId) this.changeMap(s, sync.mapId);
+  }
+
+  peersOnMap(s) {
+    const set = this.maps.get(s.mapId);
+    return set ? [...set].filter((p) => p !== s) : [];
+  }
+
+  changeMap(s, newMapId) {
+    this.leaveMap(s);
+    s.mapId = newMapId;
+    if (!this.maps.has(newMapId)) this.maps.set(newMapId, new Set());
+    const set = this.maps.get(newMapId);
+    const peers = [...set];
+    set.add(s);
+    const info = (p) => ({ tamerId: p.tamerId, tamerName: p.tamerName, species: p.species });
+    send(s.ws, { type: 'MAP_ROSTER', mapId: newMapId, players: peers.map(info) });
+    for (const p of peers) send(p.ws, { type: 'PLAYER_JOIN', mapId: newMapId, ...info(s) });
+    this.persist(s);
+  }
+
+  leaveMap(s) {
+    if (s.mapId === null) return;
+    const set = this.maps.get(s.mapId);
+    if (set) {
+      set.delete(s);
+      for (const p of set) send(p.ws, { type: 'PLAYER_LEAVE', mapId: s.mapId, tamerId: s.tamerId });
+      if (set.size === 0) this.maps.delete(s.mapId);
+    }
+    s.mapId = null;
+  }
+
+  persist(s) {
+    if (!s.pos || s.mapId === null) return;
+    try {
+      this.store.savePosition(s.tamerId, s.mapId, s.pos.x, s.pos.y, s.pos.z);
+      s.dirty = false;
+    } catch (err) {
+      this.log.error('gagal simpan posisi', s.tamerName, err.message);
+    }
+  }
+
+  remove(s, reason) {
+    if (!this.byId.has(s.sessionId)) return;
+    this.persist(s);
+    this.leaveMap(s);
+    this.byId.delete(s.sessionId);
+    if (this.byTamer.get(s.tamerId) === s) this.byTamer.delete(s.tamerId);
+    this.log.info(`sesi berakhir: ${s.tamerName} (${reason})`);
+    if (s.ws && s.ws.readyState === 1) {
+      send(s.ws, { type: 'SESSION_END', reason });
+      s.ws.close(4000, reason);
+    }
+  }
+
+  // Pemain yang berhenti mengirim UDP dikeluarkan dari map-nya (sesi WS tetap hidup).
+  sweepStale(now = Date.now()) {
+    for (const s of this.byId.values()) {
+      if (s.mapId !== null && now - s.lastUdp > this.cfg.udpStaleMs) this.leaveMap(s);
+    }
+  }
+
+  persistDirty() {
+    for (const s of this.byId.values()) if (s.dirty) this.persist(s);
+  }
+
+  removeAll(reason) { for (const s of [...this.byId.values()]) this.remove(s, reason); }
+}
+
+module.exports = { SessionManager, send };
diff --git a/game-server/src/udp.js b/game-server/src/udp.js
new file mode 100644
index 0000000..031c407
--- /dev/null
+++ b/game-server/src/udp.js
@@ -0,0 +1,44 @@
+'use strict';
+const dgram = require('dgram');
+const P = require('./protocol');
+
+// Urutan pemeriksaan sengaja dari yang paling murah ke yang paling mahal,
+// tetapi rate limit SESUDAH MAC: sessionId bukan rahasia (terkirim polos),
+// jadi tanpa MAC penyerang bisa menghabiskan kuota milik korban.
+function createUdp(sessions, cfg, log) {
+  const sock = dgram.createSocket('udp4');
+  const stats = { accepted: 0, badLen: 0, noSession: 0, badMac: 0, replay: 0, rateLimited: 0, badMap: 0 };
+
+  sock.on('message', (msg, rinfo) => {
+    if (msg.length !== P.UDP_IN_LEN || msg[0] !== P.UDP_IN_TYPE) { stats.badLen++; return; }
+    const s = sessions.get(msg.readUInt32LE(28));
+    if (!s) { stats.noSession++; return; }
+    if (!P.verifyMac(s.key, msg)) { stats.badMac++; return; }
+    const sync = P.parseSync(msg);
+    if (!P.isNewer(sync.seq, s.lastSeq)) { stats.replay++; return; }
+    if (!s.bucket.take()) { stats.rateLimited++; return; }
+    if (sync.mapId === P.MAP_NONE) { stats.badMap++; return; }
+
+    sessions.applySync(s, sync, rinfo);
+    stats.accepted++;
+
+    // Phasing: hanya pemain di Map ID yang sama yang menerima siaran.
+    const out = P.buildRelay(msg, s.tamerId);
+    for (const peer of sessions.peersOnMap(s)) {
+      if (peer.addr) sock.send(out, peer.port, peer.addr);
+    }
+  });
+
+  sock.on('error', (err) => log.error('UDP error:', err.message));
+
+  return {
+    stats,
+    bind: () => new Promise((resolve, reject) => {
+      sock.once('error', reject);
+      sock.bind(cfg.udpPort, cfg.host, () => { sock.off('error', reject); resolve(sock.address().port); });
+    }),
+    close: () => new Promise((resolve) => { try { sock.close(resolve); } catch { resolve(); } }),
+  };
+}
+
+module.exports = { createUdp };
diff --git a/game-server/src/ws.js b/game-server/src/ws.js
new file mode 100644
index 0000000..5ca8017
--- /dev/null
+++ b/game-server/src/ws.js
@@ -0,0 +1,148 @@
+'use strict';
+const WebSocket = require('ws');
+const bcrypt = require('bcryptjs');
+const { DuplicateError } = require('./db');
+const { WindowCounter, TokenBucket } = require('./limiter');
+const { send } = require('./sessions');
+
+const USERNAME_RE = /^[A-Za-z0-9_]{3,16}$/;
+const TAMER_RE = /^[A-Za-z0-9]+( [A-Za-z0-9]+)*$/; // tanpa spasi di tepi / spasi ganda
+
+function validateCredentials(m, withTamer) {
+  if (typeof m.username !== 'string' || !USERNAME_RE.test(m.username)) {
+    return 'Username harus 3-16 karakter: huruf, angka, atau underscore.';
+  }
+  if (typeof m.password !== 'string' || m.password.length < 8 || Buffer.byteLength(m.password) > 72) {
+    return 'Password harus 8-72 karakter.';
+  }
+  if (withTamer) {
+    if (typeof m.tamerName !== 'string' || m.tamerName.length < 3 || m.tamerName.length > 16 || !TAMER_RE.test(m.tamerName)) {
+      return 'Nama Tamer harus 3-16 karakter (huruf, angka, spasi tunggal).';
+    }
+  }
+  return null;
+}
+
+function createWs(sessions, store, cfg, log, udpPortRef) {
+  const wss = new WebSocket.Server({ host: cfg.host, port: cfg.wsPort, maxPayload: 4096 });
+  const loginFails = new WindowCounter(8, 10 * 60_000);   // 8 gagal / 10 menit / IP
+  const registers = new WindowCounter(5, 60 * 60_000);    // 5 akun / jam / IP
+  // Hash palsu agar waktu respon "user tidak ada" sama dengan "password salah".
+  const dummyHash = bcrypt.hashSync('dummy-password', cfg.bcryptCost);
+
+  function fail(ws, code, message) { send(ws, { type: 'ERROR', code, message }); }
+
+  function establish(ws, accountId, registered) {
+    const profile = store.loadProfile(accountId);
+    if (!profile) return fail(ws, 'NO_TAMER', 'Akun tidak punya Tamer.');
+    if (sessions.size >= cfg.maxPlayers) return fail(ws, 'SERVER_FULL', 'Server penuh.');
+    store.touchLogin(accountId);
+    const s = sessions.create({ accountId, tamer: profile.tamer, ws });
+    ws.session = s;
+    log.info(`login: ${s.tamerName} (tamer ${s.tamerId})`);
+    send(ws, {
+      type: 'LOGIN_SUCCESS',
+      protocol: 2,
+      registered: !!registered,
+      sessionId: s.sessionId,
+      sessionKey: s.key.toString('hex'),
+      udpPort: udpPortRef.port,
+      tamer: profile.tamer,
+      digimon: profile.digimon,
+      worldPhasingFlags: profile.worldPhasingFlags,
+      bossClears: profile.bossClears,
+      inventory: profile.inventory,
+    });
+  }
+
+  async function doLogin(ws, ip, m) {
+    const bad = validateCredentials(m, false);
+    if (bad) return fail(ws, 'INVALID_INPUT', bad);
+    if (loginFails.blocked(ip)) return fail(ws, 'RATE_LIMITED', 'Terlalu banyak percobaan login. Coba lagi nanti.');
+    const acc = store.getAccount(m.username);
+    let ok = false;
+    try { ok = await bcrypt.compare(m.password, acc ? acc.PasswordHash : dummyHash); } catch { ok = false; }
+    if (!acc || !ok) {
+      loginFails.record(ip);
+      return fail(ws, 'INVALID_CREDENTIALS', 'Username atau password salah.');
+    }
+    loginFails.clear(ip);
+    establish(ws, acc.AccountID, false);
+  }
+
+  async function doRegister(ws, ip, m) {
+    const bad = validateCredentials(m, true);
+    if (bad) return fail(ws, 'INVALID_INPUT', bad);
+    if (registers.blocked(ip)) return fail(ws, 'RATE_LIMITED', 'Terlalu banyak pendaftaran dari alamat ini.');
+    registers.record(ip);
+    const hash = await bcrypt.hash(m.password, cfg.bcryptCost);
+    try {
+      const { accountId } = store.createAccount(m.username, hash, m.tamerName);
+      establish(ws, accountId, true);
+    } catch (err) {
+      if (err instanceof DuplicateError) {
+        return fail(ws, err.field === 'username' ? 'USERNAME_TAKEN' : 'TAMER_NAME_TAKEN',
+          err.field === 'username' ? 'Username sudah dipakai.' : 'Nama Tamer sudah dipakai.');
+      }
+      log.error('register gagal:', err.message);
+      fail(ws, 'INTERNAL', 'Kesalahan server.');
+    }
+  }
+
+  wss.on('connection', (ws, req) => {
+    const ip = req.socket.remoteAddress || 'unknown';
+    ws.session = null;
+    ws.isAlive = true;
+    ws.busy = false;
+    const budget = new TokenBucket(5, 10); // maks ~5 pesan/detik
+    ws.on('pong', () => { ws.isAlive = true; });
+    const authTimer = setTimeout(() => { if (!ws.session) ws.close(4001, 'auth timeout'); }, cfg.authTimeoutMs);
+
+    ws.on('message', async (raw, isBinary) => {
+      if (isBinary) return ws.close(1003, 'binary tidak didukung');
+      if (!budget.take()) return fail(ws, 'RATE_LIMITED', 'Terlalu cepat.');
+      let m;
+      try { m = JSON.parse(raw.toString('utf8')); } catch { return fail(ws, 'BAD_JSON', 'JSON tidak valid.'); }
+      if (!m || typeof m !== 'object' || typeof m.type !== 'string') return fail(ws, 'BAD_MESSAGE', 'Pesan tidak valid.');
+
+      if (m.type === 'PING') return send(ws, { type: 'PONG' });
+      if (m.type !== 'LOGIN' && m.type !== 'REGISTER') return fail(ws, 'UNKNOWN_TYPE', 'Tipe pesan tidak dikenal.');
+      if (ws.session) return fail(ws, 'ALREADY_LOGGED_IN', 'Sudah login.');
+      if (ws.busy) return fail(ws, 'BUSY', 'Permintaan sebelumnya masih diproses.');
+      ws.busy = true;
+      try {
+        if (m.type === 'LOGIN') await doLogin(ws, ip, m); else await doRegister(ws, ip, m);
+      } catch (err) {
+        log.error('handler error:', err.message);
+        fail(ws, 'INTERNAL', 'Kesalahan server.');
+      } finally { ws.busy = false; }
+    });
+
+    ws.on('close', () => {
+      clearTimeout(authTimer);
+      if (ws.session) sessions.remove(ws.session, 'koneksi terputus');
+    });
+    ws.on('error', (err) => log.error('WS error:', err.message));
+  });
+
+  const heartbeat = setInterval(() => {
+    for (const ws of wss.clients) {
+      if (!ws.isAlive) { ws.terminate(); continue; }
+      ws.isAlive = false;
+      ws.ping();
+    }
+  }, 15_000);
+  heartbeat.unref();
+
+  return {
+    wss,
+    listening: () => new Promise((resolve) => (wss.address() ? resolve(wss.address().port) : wss.once('listening', () => resolve(wss.address().port)))),
+    close: () => new Promise((resolve) => {
+      clearInterval(heartbeat); loginFails.close(); registers.close();
+      for (const c of wss.clients) c.terminate();
+      wss.close(() => resolve());
+    }),
+  };
+}
+
+module.exports = { createWs };
diff --git a/game-server/test/server.test.js b/game-server/test/server.test.js
