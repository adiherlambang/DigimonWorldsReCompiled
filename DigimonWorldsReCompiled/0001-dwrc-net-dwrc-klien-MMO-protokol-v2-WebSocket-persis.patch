diff --git a/DigimonWorldsReCompiled/crates/dwrc-net/src/proto.rs b/DigimonWorldsReCompiled/crates/dwrc-net/src/proto.rs
new file mode 100644
index 0000000..6fa7aea
--- /dev/null
+++ b/DigimonWorldsReCompiled/crates/dwrc-net/src/proto.rs
@@ -0,0 +1,201 @@
+//! UDP protocol v2 (lihat docs/PROTOCOL.md di root repo).
+//!
+//! Klien -> server: 44 byte, ditandatangani HMAC-SHA256 dengan kunci sesi.
+//! Server -> klien: 32 byte relay dari pemain lain di map yang sama.
+
+use crate::state::NetShared;
+use crate::PlayerTransform;
+use hmac::{Hmac, Mac};
+use sha2::Sha256;
+use std::net::{IpAddr, SocketAddr, ToSocketAddrs, UdpSocket};
+use std::time::{Instant, SystemTime, UNIX_EPOCH};
+
+pub const UDP_IN_TYPE: u8 = 0x02;
+pub const UDP_IN_LEN: usize = 44;
+pub const UDP_OUT_TYPE: u8 = 0x03;
+pub const UDP_OUT_LEN: usize = 32;
+pub const MAC_LEN: usize = 8;
+pub const DEFAULT_UDP_PORT: u16 = 7777;
+
+/// Keadaan pemain lain yang diterima lewat UDP.
+#[derive(Debug, Clone)]
+pub struct RemotePlayer {
+    pub tamer_id: u32,
+    pub map_id: u8,
+    pub species: u16,
+    pub x: i32,
+    pub y: i32,
+    pub z: i32,
+    pub yaw: i16,
+    pub anim: u8,
+    pub digimon_anim: u8,
+    pub digimon_x: i32,
+    pub digimon_z: i32,
+    pub last_update: Instant,
+}
+
+/// MAC 8 byte = HMAC-SHA256(key, data)[0..8].
+pub fn mac8(key: &[u8], data: &[u8]) -> [u8; MAC_LEN] {
+    let mut m = Hmac::<Sha256>::new_from_slice(key).expect("HMAC menerima kunci panjang berapa pun");
+    m.update(data);
+    let full = m.finalize().into_bytes();
+    let mut out = [0u8; MAC_LEN];
+    out.copy_from_slice(&full[..MAC_LEN]);
+    out
+}
+
+/// Paket sinkronisasi posisi (klien -> server).
+pub fn pack_sync(tf: &PlayerTransform, session_id: u32, key: &[u8], seq: u32) -> [u8; UDP_IN_LEN] {
+    let mut b = [0u8; UDP_IN_LEN];
+    b[0] = UDP_IN_TYPE;
+    b[1] = (tf.map_id & 0xFF) as u8;
+    b[2..4].copy_from_slice(&tf.digimon_id.to_le_bytes());
+    b[4..8].copy_from_slice(&tf.x.to_le_bytes());
+    b[8..12].copy_from_slice(&tf.y.to_le_bytes());
+    b[12..16].copy_from_slice(&tf.z.to_le_bytes());
+    b[16..18].copy_from_slice(&tf.yaw.to_le_bytes());
+    b[18] = tf.anim_id;
+    b[19] = tf.digimon_anim;
+    b[20..24].copy_from_slice(&tf.digimon_x.to_le_bytes());
+    b[24..28].copy_from_slice(&tf.digimon_z.to_le_bytes());
+    b[28..32].copy_from_slice(&session_id.to_le_bytes());
+    b[32..36].copy_from_slice(&seq.to_le_bytes());
+    let mac = mac8(key, &b[..36]);
+    b[36..44].copy_from_slice(&mac);
+    b
+}
+
+/// Urai paket relay dari server. `None` bila bukan paket relay yang valid.
+pub fn parse_relay(buf: &[u8]) -> Option<RemotePlayer> {
+    if buf.len() != UDP_OUT_LEN || buf[0] != UDP_OUT_TYPE {
+        return None;
+    }
+    let i32_at = |o: usize| i32::from_le_bytes([buf[o], buf[o + 1], buf[o + 2], buf[o + 3]]);
+    Some(RemotePlayer {
+        tamer_id: u32::from_le_bytes([buf[28], buf[29], buf[30], buf[31]]),
+        map_id: buf[1],
+        species: u16::from_le_bytes([buf[2], buf[3]]),
+        x: i32_at(4),
+        y: i32_at(8),
+        z: i32_at(12),
+        yaw: i16::from_le_bytes([buf[16], buf[17]]),
+        anim: buf[18],
+        digimon_anim: buf[19],
+        digimon_x: i32_at(20),
+        digimon_z: i32_at(24),
+        last_update: Instant::now(),
+    })
+}
+
+/// Penghasil `seq` yang selalu naik, berbasis jam milidetik. Aman saat emulator
+/// di-restart di dalam sesi login yang sama (nilai baru tetap lebih besar).
+#[derive(Debug)]
+pub struct SeqGen {
+    last: u32,
+}
+
+impl SeqGen {
+    pub fn new() -> Self {
+        Self { last: 0 }
+    }
+    pub fn next(&mut self) -> u32 {
+        let now = SystemTime::now().duration_since(UNIX_EPOCH).map(|d| d.as_millis() as u32).unwrap_or(0);
+        // Aritmetika serial: pilih yang "lebih baru" dari last, minimal last+1.
+        let candidate = if now.wrapping_sub(self.last) < 0x8000_0000 && now != self.last { now } else { self.last.wrapping_add(1) };
+        self.last = candidate;
+        candidate
+    }
+}
+
+impl Default for SeqGen {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+/// Resolusi sekali (bukan tiap paket) alamat UDP server.
+pub fn resolve_udp(host: &str, port: u16) -> Option<SocketAddr> {
+    let host = if host.trim().is_empty() { "127.0.0.1" } else { host.trim() };
+    (host, port).to_socket_addrs().ok()?.find(|a| a.is_ipv4())
+}
+
+/// Kuras semua paket relay yang menunggu di socket (non-blocking) ke `net.remote`.
+/// Hanya menerima paket dari IP server, sisanya dibuang.
+pub fn drain_relays(sock: &UdpSocket, server_ip: IpAddr, net: &NetShared) -> usize {
+    let mut buf = [0u8; 128];
+    let mut n = 0;
+    for _ in 0..128 {
+        match sock.recv_from(&mut buf) {
+            Ok((len, src)) => {
+                if src.ip() != server_ip {
+                    continue;
+                }
+                if let Some(rp) = parse_relay(&buf[..len]) {
+                    if let Ok(mut g) = net.remote.lock() {
+                        g.insert(rp.tamer_id, rp);
+                    }
+                    n += 1;
+                }
+            }
+            Err(_) => break, // WouldBlock (tidak ada lagi) atau error socket
+        }
+    }
+    n
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tf() -> PlayerTransform {
+        PlayerTransform {
+            player_id: 0, tamer_name: String::new(), map_id: 0xDA,
+            x: 100, y: -5, z: 200, yaw: -300, anim_id: 4,
+            digimon_id: 7, digimon_x: 9, digimon_y: 0, digimon_z: 8, digimon_anim: 2,
+        }
+    }
+
+    // Vektor ini dihasilkan oleh game-server/src/protocol.js (buildClientPacket)
+    // dengan sessionId=0x11223344, key=bytes 0..31, seq=0xAABBCCDD.
+    // Jika test ini gagal, klien Rust dan server Node tidak lagi sepakat soal format.
+    const NODE_VECTOR: &str = "02da070064000000fbffffffc8000000d4fe0402090000000800000044332211ddccbbaab40d2c5db7320930";
+
+    #[test]
+    fn pack_sync_identik_dengan_server_node() {
+        let key: Vec<u8> = (0u8..32).collect();
+        let pkt = pack_sync(&tf(), 0x1122_3344, &key, 0xAABB_CCDD);
+        assert_eq!(hex::encode(pkt), NODE_VECTOR);
+    }
+
+    #[test]
+    fn parse_relay_membaca_layout_server() {
+        // Dihasilkan buildRelay() di Node dari paket di atas, tamerId=42.
+        let mut raw = hex::decode(NODE_VECTOR).unwrap();
+        raw.truncate(32);
+        raw[0] = UDP_OUT_TYPE;
+        raw[28..32].copy_from_slice(&42u32.to_le_bytes());
+        let rp = parse_relay(&raw).expect("valid");
+        assert_eq!((rp.tamer_id, rp.map_id, rp.species), (42, 0xDA, 7));
+        assert_eq!((rp.x, rp.y, rp.z, rp.yaw), (100, -5, 200, -300));
+        assert_eq!((rp.anim, rp.digimon_anim, rp.digimon_x, rp.digimon_z), (4, 2, 9, 8));
+    }
+
+    #[test]
+    fn parse_relay_menolak_paket_rusak() {
+        assert!(parse_relay(&[0u8; 31]).is_none());
+        let mut p = [0u8; 32];
+        p[0] = UDP_IN_TYPE; // type salah
+        assert!(parse_relay(&p).is_none());
+    }
+
+    #[test]
+    fn seq_selalu_naik_walau_jam_macet() {
+        let mut g = SeqGen::new();
+        let mut prev = g.next();
+        for _ in 0..1000 {
+            let n = g.next();
+            assert!(n.wrapping_sub(prev) < 0x8000_0000 && n != prev, "{prev} -> {n}");
+            prev = n;
+        }
+    }
+}
diff --git a/DigimonWorldsReCompiled/crates/dwrc-net/src/state.rs b/DigimonWorldsReCompiled/crates/dwrc-net/src/state.rs
new file mode 100644
index 0000000..781f667
--- /dev/null
+++ b/DigimonWorldsReCompiled/crates/dwrc-net/src/state.rs
@@ -0,0 +1,170 @@
+//! State jaringan yang dibagi antara thread WebSocket, thread emulasi, dan UI.
+
+use crate::proto::RemotePlayer;
+use serde_json::Value;
+use std::collections::HashMap;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Mutex;
+use std::time::Duration;
+
+/// Pemain lain di map yang sama, dari event WebSocket.
+#[derive(Debug, Clone, PartialEq)]
+pub struct PeerInfo {
+    pub name: String,
+    pub species: u16,
+}
+
+#[derive(Debug, Default)]
+pub struct NetShared {
+    /// WebSocket masih tersambung.
+    pub connected: AtomicBool,
+    /// Alasan sesi berakhir (mis. login dari tempat lain). `None` = masih hidup.
+    pub ended: Mutex<Option<String>>,
+    /// tamer_id -> nama/species, hanya untuk map pemain saat ini.
+    pub peers: Mutex<HashMap<u32, PeerInfo>>,
+    /// tamer_id -> posisi terbaru dari UDP.
+    pub remote: Mutex<HashMap<u32, RemotePlayer>>,
+}
+
+impl NetShared {
+    pub fn is_connected(&self) -> bool {
+        self.connected.load(Ordering::Relaxed)
+    }
+
+    pub fn end_reason(&self) -> Option<String> {
+        self.ended.lock().ok().and_then(|g| g.clone())
+    }
+
+    pub fn set_ended(&self, reason: &str) {
+        if let Ok(mut g) = self.ended.lock() {
+            if g.is_none() {
+                *g = Some(reason.to_string());
+            }
+        }
+    }
+
+    /// Jumlah pemain lain di map saat ini.
+    pub fn peer_count(&self) -> usize {
+        self.peers.lock().map(|g| g.len()).unwrap_or(0)
+    }
+
+    /// Salinan pemain lain beserta namanya (untuk digambar UI).
+    pub fn snapshot(&self) -> Vec<(Option<PeerInfo>, RemotePlayer)> {
+        let peers = self.peers.lock().map(|g| g.clone()).unwrap_or_default();
+        let remote = self.remote.lock().map(|g| g.values().cloned().collect::<Vec<_>>()).unwrap_or_default();
+        remote.into_iter().map(|r| (peers.get(&r.tamer_id).cloned(), r)).collect()
+    }
+
+    /// Buang pemain yang sudah lama tidak mengirim UDP.
+    pub fn expire(&self, max_age: Duration) {
+        if let Ok(mut g) = self.remote.lock() {
+            g.retain(|_, r| r.last_update.elapsed() <= max_age);
+        }
+    }
+
+    /// Terapkan satu pesan WebSocket dari server (JSON teks).
+    pub fn apply_event(&self, text: &str) {
+        let Ok(v) = serde_json::from_str::<Value>(text) else { return };
+        match v["type"].as_str() {
+            Some("MAP_ROSTER") => {
+                let mut map = HashMap::new();
+                if let Some(arr) = v["players"].as_array() {
+                    for p in arr {
+                        if let Some(id) = p["tamerId"].as_u64() {
+                            map.insert(id as u32, peer_from(p));
+                        }
+                    }
+                }
+                if let Ok(mut g) = self.peers.lock() {
+                    *g = map;
+                }
+                // Pindah map: posisi lama dari map sebelumnya tidak berlaku lagi.
+                if let Ok(mut g) = self.remote.lock() {
+                    g.clear();
+                }
+            }
+            Some("PLAYER_JOIN") => {
+                if let Some(id) = v["tamerId"].as_u64() {
+                    if let Ok(mut g) = self.peers.lock() {
+                        g.insert(id as u32, peer_from(&v));
+                    }
+                }
+            }
+            Some("PLAYER_LEAVE") => {
+                if let Some(id) = v["tamerId"].as_u64() {
+                    let id = id as u32;
+                    if let Ok(mut g) = self.peers.lock() {
+                        g.remove(&id);
+                    }
+                    if let Ok(mut g) = self.remote.lock() {
+                        g.remove(&id);
+                    }
+                }
+            }
+            Some("SESSION_END") => {
+                self.set_ended(v["reason"].as_str().unwrap_or("Sesi diakhiri server"));
+            }
+            _ => {}
+        }
+    }
+}
+
+fn peer_from(v: &Value) -> PeerInfo {
+    PeerInfo {
+        name: v["tamerName"].as_str().unwrap_or("?").to_string(),
+        species: v["species"].as_u64().unwrap_or(0) as u16,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::proto::RemotePlayer;
+    use std::time::Instant;
+
+    fn rp(id: u32) -> RemotePlayer {
+        RemotePlayer {
+            tamer_id: id, map_id: 1, species: 3, x: 0, y: 0, z: 0, yaw: 0,
+            anim: 0, digimon_anim: 0, digimon_x: 0, digimon_z: 0, last_update: Instant::now(),
+        }
+    }
+
+    #[test]
+    fn roster_join_leave() {
+        let n = NetShared::default();
+        n.remote.lock().unwrap().insert(99, rp(99));
+        n.apply_event(r#"{"type":"MAP_ROSTER","mapId":218,"players":[{"tamerId":5,"tamerName":"Ann","species":3}]}"#);
+        assert_eq!(n.peer_count(), 1);
+        assert!(n.remote.lock().unwrap().is_empty(), "roster baru membersihkan posisi map lama");
+
+        n.apply_event(r#"{"type":"PLAYER_JOIN","mapId":218,"tamerId":6,"tamerName":"Ben","species":9}"#);
+        assert_eq!(n.peers.lock().unwrap()[&6], PeerInfo { name: "Ben".into(), species: 9 });
+
+        n.remote.lock().unwrap().insert(6, rp(6));
+        n.apply_event(r#"{"type":"PLAYER_LEAVE","mapId":218,"tamerId":6}"#);
+        assert_eq!(n.peer_count(), 1);
+        assert!(n.remote.lock().unwrap().is_empty());
+    }
+
+    #[test]
+    fn session_end_dan_sampah() {
+        let n = NetShared::default();
+        n.apply_event("bukan json");
+        n.apply_event(r#"{"type":"TIDAK_DIKENAL"}"#);
+        assert!(n.end_reason().is_none());
+        n.apply_event(r#"{"type":"SESSION_END","reason":"login dari tempat lain"}"#);
+        assert_eq!(n.end_reason().as_deref(), Some("login dari tempat lain"));
+    }
+
+    #[test]
+    fn expire_membuang_yang_basi() {
+        let n = NetShared::default();
+        let mut old = rp(1);
+        old.last_update = Instant::now() - Duration::from_secs(10);
+        n.remote.lock().unwrap().insert(1, old);
+        n.remote.lock().unwrap().insert(2, rp(2));
+        n.expire(Duration::from_secs(3));
+        let g = n.remote.lock().unwrap();
+        assert!(!g.contains_key(&1) && g.contains_key(&2));
+    }
+}
diff --git a/DigimonWorldsReCompiled/crates/dwrc-net/tests/live.rs b/DigimonWorldsReCompiled/crates/dwrc-net/tests/live.rs
new file mode 100644
index 0000000..f51fd42
--- /dev/null
+++ b/DigimonWorldsReCompiled/crates/dwrc-net/tests/live.rs
@@ -0,0 +1,107 @@
+//! Tes end-to-end: klien Rust asli melawan game-server Node asli.
+//!
+//! Jalankan server dulu (`cd game-server && npm start`), lalu:
+//!   cargo test -p dwrc-net --test live -- --ignored --nocapture
+//! Host lain: set DW1_TEST_HOST. Tes membuat akun acak di database server.
+
+use dwrc_net::client::NetClient;
+use dwrc_net::proto::{self, SeqGen};
+use dwrc_net::PlayerTransform;
+use std::net::UdpSocket;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+fn host() -> String {
+    std::env::var("DW1_TEST_HOST").unwrap_or_else(|_| "127.0.0.1".to_string())
+}
+
+fn uniq() -> String {
+    format!("{:x}", SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_micros() & 0xFFFFFFFF)
+}
+
+fn tf(map: u16, x: i32, species: u16) -> PlayerTransform {
+    PlayerTransform {
+        player_id: 0, tamer_name: String::new(), map_id: map, x, y: 0, z: 50, yaw: 10, anim_id: 1,
+        digimon_id: species, digimon_x: x + 5, digimon_y: 0, digimon_z: 55, digimon_anim: 2,
+    }
+}
+
+fn wait_for(what: &str, mut f: impl FnMut() -> bool) {
+    let t = Instant::now();
+    while t.elapsed() < Duration::from_secs(4) {
+        if f() { return; }
+        std::thread::sleep(Duration::from_millis(20));
+    }
+    panic!("timeout menunggu: {what}");
+}
+
+#[test]
+#[ignore]
+fn rust_client_vs_node_server() {
+    let h = host();
+    let u = uniq();
+    let (ua, ub) = (format!("ra_{u}"), format!("rb_{u}"));
+
+    // 1) register -> sesi dengan kunci 32 byte
+    let (sa, ca) = NetClient::register(&h, &ua, "secret-pass-1", &format!("RA{}", &u[..4])).expect("register A");
+    let (sb, cb) = NetClient::register(&h, &ub, "secret-pass-2", &format!("RB{}", &u[..4])).expect("register B");
+    assert!(sa.is_online && sa.session_id != 0 && sa.session_key.len() == 32);
+    assert_ne!(sa.tamer_id, sb.tamer_id);
+    assert_eq!(sa.bits, 500);
+
+    // 2) password salah -> pesan error dari server, bukan "balasan tidak valid"
+    let err = NetClient::login(&h, &ua, "salah-total-1").err().expect("harus gagal");
+    assert!(err.contains("salah"), "pesan: {err}");
+
+    // 3) UDP v2: A dan B di map yang sama saling melihat
+    let (sock_a, sock_b) = (UdpSocket::bind("0.0.0.0:0").unwrap(), UdpSocket::bind("0.0.0.0:0").unwrap());
+    sock_a.set_nonblocking(true).unwrap();
+    sock_b.set_nonblocking(true).unwrap();
+    let addr = proto::resolve_udp(&h, sa.udp_port).expect("resolve udp");
+    let (mut ga, mut gb) = (SeqGen::new(), SeqGen::new());
+
+    let send = |s: &UdpSocket, sess: &dwrc_net::AccountSession, g: &mut SeqGen, t: &PlayerTransform| {
+        s.send_to(&proto::pack_sync(t, sess.session_id, &sess.session_key, g.next()), addr).unwrap();
+    };
+
+    send(&sock_a, &sa, &mut ga, &tf(0xDA, 1000, 3));
+    std::thread::sleep(Duration::from_millis(80));
+    send(&sock_b, &sb, &mut gb, &tf(0xDA, 2000, 7));
+
+    // WebSocket: A diberi tahu B masuk (nama + species), B menerima roster berisi A.
+    wait_for("A menerima PLAYER_JOIN B", || ca.shared.peer_count() == 1);
+    wait_for("B menerima MAP_ROSTER berisi A", || cb.shared.peer_count() == 1);
+    let peer = ca.shared.peers.lock().unwrap().get(&sb.tamer_id).cloned().expect("B ada di roster A");
+    assert!(peer.name.starts_with("RB") && peer.species == 7, "{peer:?}");
+
+    // UDP: A mengirim lagi -> B menerima relay dengan tamer_id dari server.
+    let ip = addr.ip();
+    wait_for("B menerima posisi A lewat UDP", || {
+        send(&sock_a, &sa, &mut ga, &tf(0xDA, 1111, 3));
+        std::thread::sleep(Duration::from_millis(30));
+        proto::drain_relays(&sock_b, ip, &cb.shared);
+        cb.shared.remote.lock().unwrap().contains_key(&sa.tamer_id)
+    });
+    {
+        let g = cb.shared.remote.lock().unwrap();
+        let r = &g[&sa.tamer_id];
+        assert_eq!((r.map_id, r.species, r.z), (0xDA, 3, 50));
+        assert!(r.x >= 1000 && r.digimon_x == r.x + 5, "{r:?}");
+    }
+
+    // 4) pemain di map lain tidak menerima apa-apa (phasing)
+    send(&sock_b, &sb, &mut gb, &tf(0xCC, 5, 7));
+    wait_for("A menerima PLAYER_LEAVE B", || ca.shared.peer_count() == 0);
+    assert!(ca.shared.remote.lock().unwrap().get(&sb.tamer_id).is_none());
+
+    // 5) login kedua akun yang sama menendang sesi pertama
+    let (_s2, c2) = NetClient::login(&h, &ua, "secret-pass-1").expect("login ulang A");
+    wait_for("sesi lama A berakhir", || ca.shared.end_reason().is_some());
+    assert!(c2.shared.end_reason().is_none());
+
+    // 6) drop klien = sesi putus; login lagi berhasil
+    drop(c2);
+    drop(cb);
+    std::thread::sleep(Duration::from_millis(200));
+    let again = NetClient::login(&h, &ub, "secret-pass-2").expect("login B setelah disconnect");
+    assert_eq!(again.0.tamer_id, sb.tamer_id);
+}
